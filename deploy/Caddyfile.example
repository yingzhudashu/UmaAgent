agent.example.com {
  reverse_proxy 127.0.0.1:3210
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}

# Optional: expose only the Feishu interactive-card callback. Message events use
# the official outbound long connection and do not need a public webhook.
feishu-callback.example.com {
  @card path /webhook/card
  handle @card {
    reverse_proxy 127.0.0.1:3220
  }
  respond 404
}
