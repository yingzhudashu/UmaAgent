[Unit]
Description=UmaAgent SMath Worker
After=network.target

[Service]
Type=simple
User=umasmath
Group=umasmath
SupplementaryGroups=umaagent
WorkingDirectory=/opt/uma-agent/current
EnvironmentFile=/etc/uma-agent/smath-worker.env
Environment=UMA_TELEMETRY_DIR=/var/lib/uma-agent/telemetry
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node /opt/uma-agent/current/apps/smath-worker/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/uma-workspace/smath
ReadWritePaths=/var/lib/uma-agent/telemetry

[Install]
WantedBy=multi-user.target
