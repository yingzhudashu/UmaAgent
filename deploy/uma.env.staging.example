# Store the deployed copy at /etc/uma-agent-staging/uma.env (root:root 0600).
# Reuse of model credentials is temporary and must remain low-volume staging only.
OPENAI_API_KEY=
IMAGE_GENERATION_API_KEY=
TAVILY_API_KEY=
EMBEDDING_API_KEY=
BROWSER_WORKER_TOKEN=
UMA_OAUTH_REDIRECTS=uma-mobile|com.example.uma:/oauth/callback
UMA_TELEMETRY_DIR=/var/lib/uma-agent-staging/telemetry
