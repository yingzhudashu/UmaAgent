{
  "server": {
    "host": "127.0.0.1",
    "port": 3210,
    "stateDir": "/var/lib/uma-agent/state",
    "workspaceRoots": ["/srv/uma-workspace"],
    "webOrigins": ["https://robotclaw.site", "https://www.robotclaw.site"],
    "maxUploadBytes": 20971520
  },
  "auth": { "webSessionHours": 168 },
  "providers": {
    "openai": {
      "driver": "openai",
      "baseUrl": "https://www.fastaitoken.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    }
  },
  "models": {
    "gpt-5.6-sol": {
      "provider": "openai",
      "name": "GPT-5.6 Sol",
      "api": "openai-completions",
      "contextWindow": 1050000,
      "maxOutputTokens": 128000,
      "capabilities": {
        "tools": true,
        "vision": false,
        "reasoning": true,
        "structuredOutput": true
      }
    }
  },
  "roles": {
    "default": { "provider": "openai", "id": "gpt-5.6-sol" },
    "reasoning": { "provider": "openai", "id": "gpt-5.6-sol" },
    "fast": { "provider": "openai", "id": "gpt-5.6-sol" },
    "vision": { "provider": "openai", "id": "gpt-5.6-sol" }
  },
  "defaultThinkingLevel": "medium",
  "embedding": {
    "enabled": true,
    "baseUrl": "https://api.siliconflow.cn/v1",
    "model": "BAAI/bge-m3",
    "apiKeyEnv": "EMBEDDING_API_KEY",
    "timeoutMs": 30000,
    "batchSize": 32,
    "cacheSize": 2048,
    "maxConcurrentRequests": 2,
    "retryAttempts": 2
  },
  "skillsDirs": ["/var/lib/uma-agent/state/skills"],
  "mcpServers": [
    {
      "name": "browser",
      "transport": "http",
      "url": "http://127.0.0.1:3230/mcp",
      "authTokenEnv": "BROWSER_WORKER_TOKEN"
    },
    {
      "name": "feishu",
      "transport": "http",
      "url": "http://127.0.0.1:3240/mcp",
      "authTokenEnv": "FEISHU_MCP_TOKEN"
    }
  ],
  "runtime": {
    "maxParallelSessions": 2,
    "approvalTimeoutMs": 120000,
    "toolTimeoutMs": 60000
  }
}
