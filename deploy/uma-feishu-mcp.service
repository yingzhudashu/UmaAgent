[Unit]
Description=UmaAgent Feishu MCP
After=network-online.target uma-agent.service
Wants=network-online.target

[Service]
Type=simple
User=umaagent-feishu
Group=umaagent-feishu
SupplementaryGroups=umaagent
WorkingDirectory=/opt/uma-agent/current
Environment=NODE_ENV=production
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node /opt/uma-agent/current/apps/feishu-mcp/dist/main.js --config=/etc/uma-agent/config.user.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uma-agent/feishu-mcp
UMask=0027

[Install]
WantedBy=multi-user.target
