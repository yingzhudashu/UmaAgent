# Store the deployed copy at /etc/uma-agent-staging/browser.env (root:root 0600).
BROWSER_WORKER_HOST=127.0.0.1
BROWSER_WORKER_PORT=3231
BROWSER_WORKER_AUTH_TOKEN=
PLAYWRIGHT_BROWSERS_PATH=/var/lib/uma-agent-staging/browser/.cache/ms-playwright
UMA_TELEMETRY_DIR=/var/lib/uma-agent-staging/browser-telemetry
