[Unit]
Description=UmaAgent Feishu Adapter
After=network-online.target uma-agent.service
Wants=network-online.target

[Service]
Type=simple
User=umaagent-feishu
Group=umaagent-feishu
WorkingDirectory=/opt/uma-agent/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/uma-agent/feishu.env
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node /opt/uma-agent/current/apps/feishu-adapter/dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uma-agent/feishu
UMask=0027

[Install]
WantedBy=multi-user.target
