# Docker Compose project name. Keeping it stable also keeps volume names stable.
COMPOSE_PROJECT_NAME=umaagent

# Required by the default Core + Browser Worker deployment.
# Generate independent values, for example: openssl rand -hex 32
UMA_AUTH_TOKEN=
UMA_OAUTH_REDIRECTS=uma-mobile|com.example.uma:/oauth/callback
BROWSER_WORKER_TOKEN=

# Must match providers.openai.apiKeyEnv in the selected Uma config.
OPENAI_API_KEY=

# Optional Core settings.
UMA_LOG_LEVEL=info
TAVILY_API_KEY=
EMBEDDING_API_KEY=

# Required only for: docker compose --profile feishu ...
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_OPEN_IDS=
# Both values are required to enable interactive card callbacks.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Required only when the corresponding MCP/Worker is enabled in both the
# Compose profile and Core mcpServers configuration.
FEISHU_MCP_TOKEN=
SKILL_WORKER_TOKEN=
SKILL_WORKER_ALLOWED_HASHES=
