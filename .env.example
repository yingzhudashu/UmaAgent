# Docker Compose project name. Keeping it stable also keeps volume names stable.
COMPOSE_PROJECT_NAME=umaagent

# OAuth redirect allowlist for native/mobile clients.
UMA_OAUTH_REDIRECTS=uma-mobile|com.example.uma:/oauth/callback
BROWSER_WORKER_TOKEN=

# Must match providers.openai.apiKeyEnv in the selected Uma config.
OPENAI_API_KEY=

# Optional Core settings.
UMA_LOG_LEVEL=info
TAVILY_API_KEY=
EMBEDDING_API_KEY=
