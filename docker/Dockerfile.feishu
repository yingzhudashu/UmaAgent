FROM node:22.19.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.base.json biome.json ./
COPY packages ./packages
COPY apps/feishu-adapter ./apps/feishu-adapter
RUN npm ci --ignore-scripts
RUN npm run build --workspace=@uma-agent/protocol \
 && npm run build --workspace=@uma-agent/channel-adapter \
 && npm run build --workspace=@uma-agent/client \
 && npm run build --workspace=@uma-agent/feishu-adapter

FROM node:22.19.0-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/feishu-adapter ./apps/feishu-adapter
COPY --from=build /app/packages/channel-adapter ./packages/channel-adapter
COPY --from=build /app/packages/client ./packages/client
COPY --from=build /app/packages/protocol ./packages/protocol
RUN mkdir -p /data/feishu
VOLUME ["/data/feishu"]
EXPOSE 3220
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3220/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "apps/feishu-adapter/dist/main.js"]
