{
  "server": {
    "host": "0.0.0.0",
    "port": 3210,
    "stateDir": "/data/state",
    "workspaceRoots": ["/data/workspace"],
    "webOrigins": ["http://127.0.0.1:3210"],
    "maxUploadBytes": 20971520
  },
  "auth": { "webSessionHours": 168 },
  "xianyu": { "adapterUrl": "http://xianyu-adapter:3250", "controlTokenEnv": "UMA_XIANYU_CONTROL_TOKEN" },
  "providers": {
    "openai": { "driver": "openai", "baseUrl": "https://www.fastaitoken.com", "apiKeyEnv": "OPENAI_API_KEY" }
  },
  "models": {
    "gpt-5.6-sol": {
      "provider": "openai",
      "name": "GPT-5.6 Sol",
      "api": "openai-responses",
      "contextWindow": 258000,
      "maxOutputTokens": 128000,
      "capabilities": { "tools": true, "vision": false, "reasoning": true, "structuredOutput": true }
    }
  },
  "roles": {
    "default": { "provider": "openai", "id": "gpt-5.6-sol" },
    "reasoning": { "provider": "openai", "id": "gpt-5.6-sol" },
    "fast": { "provider": "openai", "id": "gpt-5.6-sol" },
    "vision": { "provider": "openai", "id": "gpt-5.6-sol" }
  },
  "defaultThinkingLevel": "medium",
  "embedding": {
    "enabled": true,
    "baseUrl": "https://api.siliconflow.cn/v1",
    "model": "BAAI/bge-m3",
    "apiKeyEnv": "EMBEDDING_API_KEY",
    "timeoutMs": 30000,
    "batchSize": 32,
    "cacheSize": 2048,
    "maxConcurrentRequests": 2,
    "retryAttempts": 2
  },
  "skillsDirs": ["/data/state/skills"],
  "mcpServers": [
    {
      "name": "browser",
      "transport": "http",
      "url": "http://browser-worker:3230/mcp",
      "authTokenEnv": "BROWSER_WORKER_TOKEN"
    }
  ],
  "runtime": { "maxParallelSessions": 4, "approvalTimeoutMs": 120000, "toolTimeoutMs": 60000 }
}
