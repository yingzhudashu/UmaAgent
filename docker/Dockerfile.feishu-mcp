FROM node:22.19.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.base.json biome.json ./
COPY packages ./packages
COPY apps/feishu-mcp ./apps/feishu-mcp
RUN npm ci --ignore-scripts
RUN npm run build --workspace=@uma-agent/protocol && npm run build --workspace=@uma-agent/client && npm run build --workspace=@uma-agent/feishu-mcp

FROM node:22.19.0-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/client/package.json ./packages/client/package.json
COPY packages/protocol/package.json ./packages/protocol/package.json
COPY apps/feishu-mcp/package.json ./apps/feishu-mcp/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace=@uma-agent/feishu-mcp
COPY --from=build /app/packages/client/dist ./packages/client/dist
COPY --from=build /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=build /app/apps/feishu-mcp/dist ./apps/feishu-mcp/dist
EXPOSE 3240
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3240/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "apps/feishu-mcp/dist/main.js"]
