{
  "server": {
    "host": "127.0.0.1",
    "port": 3210,
    "stateDir": ".uma",
    "workspaceRoots": ["."],
    "webOrigins": [],
    "maxUploadBytes": 20971520
  },
  "auth": {
    "tokenEnv": "UMA_AUTH_TOKEN",
    "webSessionHours": 168
  },
  "models": [
    {
      "provider": "openai",
      "id": "gpt-5.2",
      "name": "GPT-5.2",
