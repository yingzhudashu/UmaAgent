    "lucide-react": "1.33.0",
    "marked": "18.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.4",
    "vite": "8.2.1"
