{
  "server": {
    "host": "127.0.0.1",
    "port": 3210,
    "stateDir": "%LOCALAPPDATA%/UmaAgent/state",
    "workspaceRoots": ["%LOCALAPPDATA%/UmaAgent/workspaces"],
    "webOrigins": ["http://127.0.0.1:3210", "http://127.0.0.1:3211"],
    "maxUploadBytes": 20971520
  },
  "auth": { "webSessionHours": 168 },
  "providers": {
    "openai": {
      "driver": "openai",
      "baseUrl": "https://api.tcvps.cn/v1",
      "apiKeyEnv": "UMA_BACKUP_OPENAI_API_KEY"
    }
  },
  "models": {
    "gpt-5.6-sol": {
      "provider": "openai",
      "name": "GPT-5.6 Sol",
      "api": "openai-responses",
      "contextWindow": 258000,
      "maxOutputTokens": 128000,
      "capabilities": { "tools": true, "vision": false, "reasoning": true, "structuredOutput": true }
    }
  },
  "roles": {
    "default": { "provider": "openai", "id": "gpt-5.6-sol" },
    "reasoning": { "provider": "openai", "id": "gpt-5.6-sol" },
    "fast": { "provider": "openai", "id": "gpt-5.6-sol" },
    "vision": { "provider": "openai", "id": "gpt-5.6-sol" }
  },
  "defaultThinkingLevel": "medium",
  "skillsDirs": ["%LOCALAPPDATA%/UmaAgent/state/skills"],
  "mcpServers": [],
  "runtime": { "maxParallelSessions": 4, "approvalTimeoutMs": 120000, "toolTimeoutMs": 60000 }
}
